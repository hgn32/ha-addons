{
  "name": "Nintendo Music Bridge",
  "description": "Nintendo Music の Web 版を公式 Chrome で再生し、音声を VBAN で Music Assistant へ送るアドオン（フェーズ0: 実現可否の確認用）",
  "version": "0.1.0",
  "slug": "nintendo_music_bridge",
  "url": "https://github.com/hgn32/ha-addons",
  "init": false,
  "arch": [
    "amd64"
  ],
  "startup": "application",
  "boot": "auto",
  "host_network": true,
  "ingress": true,
  "ingress_port": 8481,
  "panel_icon": "mdi:music-circle",
  "panel_title": "Nintendo Music",
  "options": {
    "vban_host": "127.0.0.1",
    "vban_port": 6980,
    "vban_stream_name": "NintendoMusic",
    "sample_rate": 48000
  },
  "schema": {
    "vban_host": "str",
    "vban_port": "port",
    "vban_stream_name": "match(^[A-Za-z0-9]{1,16}$)",
    "sample_rate": "list(44100|48000)"
  },
  "image": "ghcr.io/hgn32/nintendo-music-bridge"
}
