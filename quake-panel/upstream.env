# アプリ本体の取得元。ビルド時に GitHub Actions がトークン付きで取得し、
# ビルドコンテキストの upstream/ へ置く (Dockerfile はそれを COPY するだけ)。
# 上流が private へ戻っても取得できるよう、Dockerfile 内では clone しない。
#
# ref を動かしたら config.json の version も必ず上げること
# (でないと HA が更新を検知しない)。
UPSTREAM_REPO=hgn32/quake-panel
UPSTREAM_REF=bfbc048e6bc048b5d626e72601d123813ce3d3b0
