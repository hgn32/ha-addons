{
  "name": "Quake Panel",
  "description": "常時表示型の地震速報パネル。強震モニタのリアルタイム震度マップを表示し、緊急地震速報・地震情報・津波予報を音と画面明滅で知らせます。",
  "version": "0.1.7",
  "slug": "quake_panel",
  "url": "https://github.com/hgn32/quake-panel",
  "init": false,
  "homeassistant_api": true,
  "hassio_api": false,
  "arch": [
    "amd64",
    "aarch64"
  ],
  "startup": "services",
  "boot": "auto",
  "host_network": false,
  "ingress": true,
  "ingress_port": 8080,
  "panel_icon": "mdi:pulse",
  "panel_title": "地震速報",
  "ports": {
    "8080/tcp": 8080
  },
  "ports_description": {
    "8080/tcp": "キオスク端末 (Raspberry Pi 等) から認証なしで開くための直接アクセス用。LAN 内に留めること"
  },
  "options": {
    "notify_home_assistant": true,
    "notify_min_intensity": "すべて",
    "notify_prefectures": "",
    "kmoni_layer": "acmap",
    "kmoni_idle_frame_interval_sec": 1,
    "kmoni_active_frame_interval_sec": 1,
    "log_level": "info"
  },
  "schema": {
    "notify_home_assistant": "bool",
    "notify_min_intensity": "list(すべて|震度1以上|震度2以上|震度3以上|震度4以上|震度5弱以上|震度5強以上|震度6弱以上)",
    "notify_prefectures": "str?",
    "kmoni_layer": "list(jma|acmap|vcmap|dcmap)",
    "kmoni_idle_frame_interval_sec": "float(0.5,60)",
    "kmoni_active_frame_interval_sec": "float(0.5,60)",
    "log_level": "list(debug|info|warn|error)"
  },
  "image": "ghcr.io/hgn32/quake-panel"
}
