{
  "name": "Quake Panel",
  "description": "常時表示型の地震速報パネル。強震モニタのリアルタイム震度マップを表示し、緊急地震速報・地震情報・津波予報を音と画面明滅で知らせます。",
  "version": "0.2",
  "slug": "quake_panel",
  "url": "https://github.com/hgn32/quake-panel",
  "init": false,
  "homeassistant_api": false,
  "hassio_api": false,
  "arch": [
    "amd64",
    "aarch64"
  ],
  "startup": "services",
  "boot": "auto",
  "host_network": false,
  "ingress": true,
  "ingress_port": 8080,
  "panel_icon": "mdi:pulse",
  "panel_title": "地震速報",
  "ports": {
    "8080/tcp": 8080
  },
  "ports_description": {
    "8080/tcp": "キオスク端末 (Raspberry Pi 等) から認証なしで開くための直接アクセス用。LAN 内に留めること"
  },
  "options": {
    "home_lat": 35.681,
    "home_lon": 139.767,
    "tsunami_home_areas": [
      "東京都"
    ],
    "kmoni_idle_frame_interval_ms": 1000,
    "kmoni_active_frame_interval_ms": 1000,
    "quake_history_size": 12,
    "log_level": "info"
  },
  "schema": {
    "home_lat": "float(-90,90)",
    "home_lon": "float(-180,180)",
    "tsunami_home_areas": [
      "str"
    ],
    "kmoni_idle_frame_interval_ms": "int(500,10000)",
    "kmoni_active_frame_interval_ms": "int(500,10000)",
    "quake_history_size": "int(1,50)",
    "log_level": "list(debug|info|warn|error)"
  },
  "image": "ghcr.io/hgn32/quake-panel"
}
